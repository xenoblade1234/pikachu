# Geheimnisse – überschreiben die Werte in user_data/config.json.
# Wird von setup_oracle_vm.sh als .env angelegt.

# Börsen-API (nur für Live-Trading nötig). Rechte: nur Trading, KEINE Auszahlungen!
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Web-Oberfläche (FreqUI)
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=

# Telegram (optional): Token von @BotFather, Chat-ID von @userinfobot
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=
