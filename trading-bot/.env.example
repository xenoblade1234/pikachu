# paper = Simulation (kein echtes Geld), live = echte Orders
MODE=paper

# Börse (ccxt-Name), z.B. binance, kraken, bitget, kucoin
EXCHANGE=binance
API_KEY=
API_SECRET=

SYMBOL=BTC/USDT
TIMEFRAME=1h
BUDGET=100

FAST_EMA=9
SLOW_EMA=21
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
# Bot stoppt komplett, wenn das Budget um diesen Prozentsatz gefallen ist
MAX_DRAWDOWN_PCT=20
POLL_SECONDS=60
